{
  "name": "dare-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:production": "next build",
    "start": "next start",
    "start:development": "next start",
    "start:production": "next start",
    "restart:production": "pm2 restart dare-app || npm run start:production",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "qa:e2e": "playwright test",
    "type-check": "tsc --noEmit",
    "audit:supabase": "node scripts/audit-supabase-usage.mjs",
    "load-test:feeds": "node scripts/load-test-social-feeds.mjs",
    "mobile:sync": "cap sync",
    "mobile:android": "cap run android",
    "mobile:ios": "cap run ios",
    "mobile:open:android": "cap open android",
    "mobile:open:ios": "cap open ios",
    "clean": "rm -rf .next out",
    "deploy:production": "npm run build:production && npm run restart:production",
    "deploy:vercel": "vercel --prod",
    "security:audit": "npm audit",
    "security:audit:fix": "npm audit fix",
    "security:audit:production": "npm audit --production"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/core": "^6.2.1",
    "@capacitor/ios": "^6.2.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "@types/dompurify": "^3.0.5",
    "dompurify": "^3.4.1",
    "lucide-react": "^0.575.0",
    "next": "^16.2.4",
    "react": "^19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.1",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.11.24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.6",
    "typescript": "^5"
  }
}
