# Fresh Supabase project only. Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
SUPABASE_SECRET_KEY=sb_secret_your_server_only_key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Development/staging resource counters. Never records tokens or payload bodies.
NEXT_PUBLIC_RESOURCE_METRICS=false

# Keep enabled until representative warm/cold staging runs show DB cache cost
# exceeds ranked-feed RPC savings. Set false for controlled A/B measurement.
FEED_DB_CACHE_ENABLED=true
